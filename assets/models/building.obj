
# Rooftop Solar Analyzer - Building Model
# Dimensions: 2 x 2 x 2 units

o MainBuilding

# Bottom vertices
v -1.0 0.0 -1.0
v  1.0 0.0 -1.0
v  1.0 0.0  1.0
v -1.0 0.0  1.0

# Top vertices
v -1.0 2.0 -1.0
v  1.0 2.0 -1.0
v  1.0 2.0  1.0
v -1.0 2.0  1.0

# Surface normals
vn  0.0  0.0 -1.0
vn  0.0  0.0  1.0
vn -1.0  0.0  0.0
vn  1.0  0.0  0.0
vn  0.0  1.0  0.0
vn  0.0 -1.0  0.0

# Back wall
f 1//1 5//1 6//1 2//1

# Front wall
f 4//2 3//2 7//2 8//2

# Left wall
f 1//3 4//3 8//3 5//3

# Right wall
f 2//4 6//4 7//4 3//4

# Flat rooftop
f 5//5 8//5 7//5 6//5

# Bottom
f 1//6 2//6 3//6 4//6
